# ==============================================================================
# YUZU SaaS Platform — Environment Variables
# ==============================================================================

# Supabase Project URL (Public / Safe for browser client)
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Public Key (Public / Safe for browser client)
# Subject to PostgreSQL Row Level Security (RLS) policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Or:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase Service Role Key (Server-Only / Confidential)
# WARNING: NEVER expose this key to client-side code, git, or NEXT_PUBLIC_* variables.
# Only use in secure backend scripts or server administration jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Production Site URL (Optional, for explicit auth redirects and email verification links)
# Example: https://yuzu.vercel.app or https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
